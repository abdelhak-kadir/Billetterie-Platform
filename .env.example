APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

MYSQL_DATABASE=billetterie
MYSQL_USER=billetterie
MYSQL_PASSWORD=billetterie
MYSQL_ROOT_PASSWORD=root
DATABASE_URL="mysql://billetterie:billetterie@database:3306/billetterie?serverVersion=8.0&charset=utf8mb4"

# Durée des réservations locales, en secondes.
RESERVATION_TTL_SECONDS=600

# Intégration facultative : clé réelle dans var/credentials/, jamais dans Git.
SHEETS_ENABLED=0
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB="Ventes Horizon"
GOOGLE_APPLICATION_CREDENTIALS=/app/var/credentials/google-sheets.json
