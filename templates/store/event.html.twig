{% extends 'store/base.html.twig' %}{% block title %}{{ event.titre }}{% endblock %}{% block body %}<section class="hero event-hero"><img class="hero-image" src="{{ event_art(event) }}" alt=""><div class="hero-shade"></div><div class="hero-copy"><p class="eyebrow">{{ event.type.label }}</p><h1>{{ event.titre }}</h1><p>{{ event.description }}</p><a class="btn btn-primary" href="#representations">Choisir ma séance ↓</a></div></section><section id="representations"><div class="page-head"><div><p class="eyebrow">La programmation</p><h2>Choisissez votre représentation</h2><p class="muted">Horaires en Africa/Casablanca</p></div></div><nav class="date-nav" aria-label="Dates de représentation">{% for rep in representations %}<a href="#seance-{{ rep.id }}">{{ rep.debut|date('d/m', 'Africa/Casablanca') }}<strong>{{ rep.debut|date('H:i', 'Africa/Casablanca') }}</strong></a>{% endfor %}</nav><div class="sessions">{% for rep in representations %}<a class="session" id="seance-{{ rep.id }}" href="{{ path('store_plan', {id: rep.id}) }}"><strong>{{ rep.debut|date('H:i', 'Africa/Casablanca') }}</strong><span>{{ rep.debut|date('d/m/Y', 'Africa/Casablanca') }}</span><p>{{ rep.salle.nom }} · {{ rep.statut.label }}</p><span class="session-link">Voir le plan et choisir mes places ↗</span></a>{% else %}<p class="empty">Aucune représentation programmée.</p>{% endfor %}</div></section>{% endblock %}
