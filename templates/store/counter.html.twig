{% extends 'store/base.html.twig' %}{% block title %}Guichet{% endblock %}{% block body %}<p class="eyebrow">Espace personnel autorisé</p><h1>Vente au guichet</h1><p class="muted">Choisissez une représentation. Les places et les prix seront revérifiés au serveur.</p><div class="order-list">{% for rep in representations %}<article class="card"><h2>{{ rep.evenement.titre }}</h2><p>{{ rep.debut|casablanca_date }} · {{ rep.salle.nom }} · {{ rep.statut.label }}</p><a class="btn btn-primary" href="/guichet/representations/{{ rep.id }}/plan">Ouvrir le plan →</a></article>{% else %}<p class="empty">Aucune représentation.</p>{% endfor %}</div>{% endblock %}
