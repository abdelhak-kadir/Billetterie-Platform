{% extends 'store/base.html.twig' %}{% block title %}Mes commandes{% endblock %}{% block body %}<h1>Mes commandes</h1><p class="muted">{{ app.user.email }}</p><div class="order-list">{% for order in orders %}<article class="card"><h2>{{ order.reference }}</h2><p>{{ order.statut.label }} · {{ order.creeA|casablanca_date }}</p><a href="/commandes/{{ order.id }}">Voir la commande et les billets →</a></article>{% else %}<p class="empty">Aucune commande pour votre compte.</p><a class="btn btn-primary" href="/">Découvrir les événements</a>{% endfor %}</div>{% endblock %}
