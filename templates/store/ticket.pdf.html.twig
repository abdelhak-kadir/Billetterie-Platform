<!doctype html><html lang="fr"><head><meta charset="utf-8"><style>
@page{margin:22pt}body{font-family:'DejaVu Sans',sans-serif;font-size:10pt;color:#19232e;margin:0}.brand{font-size:26pt;font-weight:bold;letter-spacing:3pt;margin:0;color:#19232e}.eyebrow{font-size:8pt;letter-spacing:1.5pt;color:#745008;margin:2pt 0 10pt}.rule{border-top:3pt solid #e7aa30;margin:8pt 0 14pt}table{width:100%;border-collapse:collapse}td{vertical-align:top}h1{font-size:19pt;line-height:1.15;margin:0 0 12pt}.details{font-size:10pt;line-height:1.7;margin:0 0 8pt}.seat{font-size:15pt;font-weight:bold;margin:10pt 0}.reference{font-size:8pt;color:#425064;word-break:break-all}.qr{width:160pt;height:160pt}.qr-cell{width:170pt;text-align:center;padding-left:12pt}.note{font-size:7.5pt;color:#4f5c69;line-height:1.4}.footer{border-top:1pt solid #d7dce0;margin-top:12pt;padding-top:8pt;font-size:7.5pt;color:#4f5c69}
</style></head><body>{% set rep=ticket.inventairePlace.representation %}{% set place=ticket.inventairePlace.place %}<p class="brand">HORIZON</p><p class="eyebrow">SALLE CULTURELLE · BILLET ÉLECTRONIQUE</p><div class="rule"></div><table><tr><td><h1>{{ rep.evenement.titre }}</h1><p class="details"><strong>{{ rep.debut|date('d/m/Y', 'Africa/Casablanca') }} à {{ rep.debut|date('H:i', 'Africa/Casablanca') }}</strong><br>Africa/Casablanca<br>{{ rep.salle.nom }}</p><p class="seat">{{ place.zone.nom }} · Rangée {{ place.rangee }} · Place {{ place.numero }}</p><p>{{ ticket.tarif.libelle }} · {{ ticket.prixPayeCentimes|mad }}</p><p class="reference">Référence : {{ ticket.reference }}</p></td><td class="qr-cell"><img class="qr" src="{{ qr }}" alt="QR de contrôle du billet"><p class="note">Présentez ce code au personnel.<br>La validité est revérifiée en ligne.</p></td></tr></table><p class="footer">Conservez ce billet et présentez-le au personnel. Un billet annulé est invalide, même si une copie a été téléchargée auparavant. Démonstration Horizon : paiement simulé.</p></body></html>
