{% extends 'store/base.html.twig' %}{% block title %}Contrôle du billet{% endblock %}{% block body %}<p class="eyebrow">Contrôle réservé au personnel</p><h1>{{ ticket.statut.value == 'valide' ? 'Billet valide' : 'Billet annulé — invalide' }}</h1><article class="card"><h2>{{ ticket.inventairePlace.representation.evenement.titre }}</h2><p>{{ ticket.inventairePlace.representation.debut|casablanca_date }} · {{ ticket.inventairePlace.representation.salle.nom }}</p><p>{{ ticket.inventairePlace.place.libelle }}</p><p>{{ ticket.reference }}</p><p class="store-note">Ce contrôle consulte l’état courant. Il ne marque pas une entrée et ne donne pas de droit de téléchargement.</p></article><a href="{{ path('counter_index') }}">Retour au guichet</a>{% endblock %}
