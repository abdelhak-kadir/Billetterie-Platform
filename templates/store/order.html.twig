{% extends 'store/base.html.twig' %}{% block title %}Ma commande{% endblock %}{% block body %}<p class="eyebrow">Votre commande</p><h1>{{ order.reference }}</h1><p class="store-status">{{ order.statut.label }}</p><p>{{ order.canal.label }} · {{ order.emailClient }}</p>{% if order.reservationExpireA and order.statut.value == 'en_attente' %}<div class="store-selection"><strong>Places réservées temporairement</strong><p>Échéance serveur : <time datetime="{{ order.reservationExpireA|date('c') }}">{{ order.reservationExpireA|casablanca_date }}</time> · Africa/Casablanca</p></div>{% endif %}<div class="order-list">{% for item in order.reservationItems %}<article class="card"><h2>{{ item.inventairePlace.representation.evenement.titre }}</h2><p>{{ item.inventairePlace.representation.debut|casablanca_date }} · {{ item.inventairePlace.place.libelle }}</p><p>{{ item.tarif.libelle }} · {{ item.prixCentimes|mad }}</p></article>{% endfor %}</div><div class="order-list">{% for ticket in order.billets %}<article class="card ticket-card"><h2>Billet {{ ticket.reference }}</h2><p>{{ ticket.inventairePlace.place.libelle }} · {{ ticket.statut.label }} · {{ ticket.prixPayeCentimes|mad }}</p><a href="/billets/{{ ticket.id }}">Voir mon billet →</a></article>{% endfor %}</div>{% endblock %}
