{% extends 'store/base.html.twig' %}{% block title %}Ma commande{% endblock %}{% block body %}<p class="eyebrow">Votre commande</p><h1>{{ order.reference }}</h1><p class="store-status">{{ order.statut.label }}</p><p>{{ order.canal.label }} · {{ order.emailClient }}</p>{% if order.reservationExpireA and order.statut.value == 'en_attente' %}<div class="store-selection"><strong>Places réservées temporairement</strong><p>Échéance serveur : <time datetime="{{ order.reservationExpireA|date('c') }}">{{ order.reservationExpireA|casablanca_date }}</time> · Africa/Casablanca</p></div>{% endif %}
{% if demo_mode() %}<section class="store-simulation"><h2>Paiement de démonstration</h2><p>Aucun mouvement bancaire réel. L’échéance est vérifiée au serveur à la confirmation.</p><div class="store-actions">{% if order.statut.value == 'en_attente' %}{% for action,label in {confirm: 'Simuler un paiement réussi', fail: 'Simuler un paiement échoué', cancel: 'Abandonner la réservation'} %}<form method="post" action="{{ path('store_payment', {id:order.id, action:action}) }}"><input type="hidden" name="_token" value="{{ csrf_token('store-' ~ action ~ '-' ~ order.id) }}"><button class="btn {{ action == 'confirm' ? 'btn-primary' : 'btn-secondary' }}" type="submit">{{ label }}</button></form>{% endfor %}{% elseif order.statut.value == 'payee' %}<form method="post" action="{{ path('store_payment', {id:order.id, action:'cancel'}) }}"><input type="hidden" name="_token" value="{{ csrf_token('store-cancel-' ~ order.id) }}"><button class="btn btn-secondary" type="submit">Annuler et rembourser (simulation)</button></form>{% endif %}</div></section>{% endif %}
{% set total = 0 %}<div class="order-list">{% for item in order.reservationItems %}{% set total = total + item.prixCentimes %}<article class="card"><h2>{{ item.inventairePlace.representation.evenement.titre }}</h2><p>{{ item.inventairePlace.representation.debut|casablanca_date }} · {{ item.inventairePlace.place.libelle }}</p><p>{{ item.tarif.libelle }} · {{ item.prixCentimes|mad }}</p></article>{% endfor %}</div>{% if order.reservationItems|length %}<p class="store-total">Total accepté : {{ total|mad }}</p>{% endif %}<div class="order-list">{% for ticket in order.billets %}<article class="card ticket-card"><h2>Billet {{ ticket.reference }}</h2><p>{{ ticket.inventairePlace.place.libelle }} · {{ ticket.statut.label }} · {{ ticket.prixPayeCentimes|mad }}</p><a href="/billets/{{ ticket.id }}">Voir mon billet →</a></article>{% endfor %}</div>{% endblock %}
