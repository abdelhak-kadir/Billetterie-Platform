<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{% block title %}Horizon{% endblock %} · Billetterie</title><link rel="stylesheet" href="/admin/admin.css"><link rel="stylesheet" href="/store/store.css">{% block stylesheets %}{% endblock %}</head>
<body><a class="skip-link" href="#contenu">Aller au contenu</a><header class="topbar"><div class="container topbar-inner"><a class="brand" href="/" aria-label="Horizon, catalogue"><span class="brand-mark" aria-hidden="true"></span><span><strong>HORIZON</strong><small>SALLE CULTURELLE · BILLETTERIE</small></span></a><nav class="topnav" aria-label="Navigation"><a href="/">Événements</a>{% if app.user %}<a href="{{ path('account') }}">Mes commandes</a>{% if is_granted('ROLE_GUICHETIER') %}<a href="/guichet">Guichet</a>{% endif %}{% if is_granted('ROLE_ADMIN') %}<a href="/admin">Administration</a>{% endif %}<form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="btn btn-secondary" type="submit">Déconnexion</button></form>{% else %}<a href="{{ path('app_login') }}">Connexion</a><a href="{{ path('app_register') }}">Créer un compte</a>{% endif %}</nav></div></header><main class="container" id="contenu">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash flash-{{ type }}" role="alert">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main><footer class="container footer">HORIZON · Africa/Casablanca · MAD</footer>{% block javascripts %}{% endblock %}</body></html>
