{% extends 'store/base.html.twig' %}{% block title %}Tarifs et récapitulatif{% endblock %}{% block javascripts %}<script type="module" src="/store/checkout.js"></script>{% endblock %}{% block body %}<p class="store-steps">1. Places → <strong>2. Tarifs et récapitulatif</strong> → 3. Paiement → Billets</p><div class="page-head"><div><p class="eyebrow">{{ counter ? 'Vente au guichet' : 'Votre sortie Horizon' }}</p><h1>Tarifs et récapitulatif</h1><p>{{ representation.evenement.titre }} · {{ representation.debut|casablanca_date }}</p></div></div><div class="store-checkout">{{ form_start(form, {attr: {'data-checkout': ''}}) }}<div class="card">{{ form_errors(form) }}{% if counter %}{{ form_row(form.email) }}<p class="store-note">Tarifs réduit et groupe : vérifier les conditions auprès du destinataire. Aucun critère d’âge ou seuil de groupe n’est défini pour cette démonstration.</p>{% endif %}{% for seat in seats %}<div class="store-line">{{ form_row(attribute(form, 'tariff_' ~ seat.id)) }}</div>{% endfor %}{% if not hasTariffs %}<p role="alert">Aucun tarif autorisé disponible. Contactez le personnel.</p>{% endif %}<div class="store-simulation">{{ demo_mode() ? 'Démonstration : aucun paiement bancaire réel.' : 'Les ventes de démonstration sont désactivées dans cet environnement.' }}</div><button class="btn btn-primary" type="submit" {{ not hasTariffs or not demo_mode() ? 'disabled' : '' }}>Réserver ces places</button>{{ form_rest(form) }}</div>{{ form_end(form) }}<aside><div class="store-selection"><p class="eyebrow">Sélection locale · pas encore réservée</p><h2 class="store-summary-title">{{ seats|length }} place(s) sélectionnée(s)</h2><details open data-checkout-seats><summary>Voir les sièges sélectionnés</summary><ul class="store-recap-list">{% for seat in seats %}<li>{{ seat.label }}</li>{% endfor %}</ul></details><p class="store-total" data-checkout-total>{{ total|mad }}</p><p class="store-note">{{ representation.salle.nom }} · Africa/Casablanca<br>La disponibilité et le prix sont vérifiés au serveur à la réservation.</p><a href="{{ path(counter ? 'counter_plan' : 'store_plan', {id: representation.id, seats: ids}) }}">← Revoir les places</a></div></aside></div>{% endblock %}
