{% extends 'store/base.html.twig' %}{% block title %}Plan · {{ representation.evenement.titre }}{% endblock %}{% block stylesheets %}<link rel="stylesheet" href="/admin/seat-map.css">{% endblock %}{% block javascripts %}<script type="module" src="/store/seat-plan.js"></script>{% endblock %}{% block body %}<p class="store-steps">{{ counter ? 'Vente au guichet' : 'Votre sortie' }} · <strong>1. Places</strong> → 2. Tarifs et récapitulatif → 3. Paiement → Billets</p><div class="h-admin-plan" data-store-seat-screen data-checkout-url="{{ path(counter ? 'counter_checkout' : 'store_checkout', {id: representation.id}) }}"><aside class="h-event-aside"><a class="h-aside-back" href="{{ counter ? path('counter_index') : path('store_event', {id: representation.evenement.id}) }}">← {{ counter ? 'Choisir une représentation' : 'Retour à l’événement' }}</a><img class="h-aside-poster" src="{{ event_art(representation.evenement) }}" alt="" width="240" height="360"><div class="h-aside-content"><p class="eyebrow">{{ representation.evenement.type.label }}</p><h1>{{ representation.evenement.titre }}</h1><p>{{ representation.salle.nom }}</p><p class="h-active-date">{{ representation.debut|date('d/m/Y', 'Africa/Casablanca') }}<strong>{{ representation.debut|date('H:i', 'Africa/Casablanca') }}</strong><small>Africa/Casablanca</small></p><span class="badge">{{ representation.statut.label }}</span></div><button class="btn btn-secondary" type="button" data-open-dates>Dates et représentations</button><nav class="h-plan-jumps"><a href="#store-plan-title">Aller au plan ↓</a>{% if selectable %}<a href="#store-plan-selection">Sélection ↓</a>{% endif %}</nav></aside><div class="h-working-area">{% if rejectedCount %}<p class="h-conflict" role="alert">La disponibilité a changé. {{ rejectedCount }} place(s) retirée(s) ; revoyez votre sélection. Aucune nouvelle réservation n’a été créée.</p>{% endif %}{% if not selectable %}<p class="h-conflict">La vente est fermée. Ce plan reste consultable.</p>{% endif %}{% embed 'components/seat_map/_map.html.twig' with {instanceId: 'store-plan', seatMap: seatMap, selectable: selectable, initialMode: initialMode, selected: selected, counter: counter, defaultTariff: defaultTariff} only %}{% block selection_extra %}{% if counter and defaultTariff %}<p class="h-map-help"><strong data-selected-total data-unit-price="{{ defaultTariff.prixCentimes }}">Total estimé au plein tarif : 0,00 MAD</strong><br>Les tarifs seront choisis à l’étape suivante.</p>{% endif %}{% endblock %}{% endembed %}</div><dialog class="h-dates-dialog" data-dates-dialog aria-labelledby="store-dates-title"><div class="h-dialog-head"><div><p class="eyebrow">La programmation réelle</p><h2 id="store-dates-title">Dates et représentations</h2></div><button class="btn btn-secondary" type="button" data-close-dates>Fermer les dates</button></div><p>{{ representation.evenement.titre }} · Africa/Casablanca</p><nav class="h-date-options">{% for rep in representations %}<a href="{{ path(counter ? 'counter_plan' : 'store_plan', {id: rep.id}) }}" data-change-representation data-active="{{ rep.id == representation.id ? 'true' : 'false' }}" {% if rep.id == representation.id %}aria-current="true"{% endif %}><span>{{ rep.debut|date('d/m/Y', 'Africa/Casablanca') }}</span><strong>{{ rep.debut|date('H:i', 'Africa/Casablanca') }}</strong><small>{{ rep.salle.nom }} · {{ rep.statut.label }}</small></a>{% endfor %}</nav><div class="h-change-warning" data-change-warning hidden role="alert"><p>Changer de représentation effacera les <strong data-pending-count></strong> places sélectionnées localement. Aucune réservation n’a encore été créée.</p><div class="actions"><button class="btn btn-secondary" type="button" data-cancel-change>Garder ma sélection</button><button class="btn btn-primary" type="button" data-confirm-change>Changer et effacer</button></div></div></dialog></div>{% endblock %}
