{% extends 'store/base.html.twig' %}{% block title %}Événements{% endblock %}{% block body %}<div class="page-head"><div><p class="eyebrow">Votre prochaine sortie commence ici</p><h1>Vivez la scène.</h1><p class="muted">Concerts, théâtre et rencontres à Horizon.</p></div></div><form method="get" class="filters" role="search"><div><label for="q">Rechercher un événement</label><input id="q" name="q" value="{{ q }}" placeholder="Titre de l’événement"></div><button class="btn btn-secondary" type="submit">Rechercher</button></form><div class="poster-grid">{% for event in events %}<a class="poster-link" href="{{ path('store_event', {id: event.id}) }}"><article class="poster"><img src="{{ event_art(event) }}" alt="" width="320" height="480"><span class="poster-type">{{ event.type.label }}</span><span class="poster-title" aria-hidden="true">{{ event.titre }}</span></article><div class="poster-caption"><h2>{{ event.titre }}</h2><p>Découvrir les représentations ↗</p></div></a>{% else %}<p class="empty">Aucun événement ne correspond à votre recherche.</p>{% endfor %}</div>{% endblock %}
