{% extends 'store/base.html.twig' %}{% block title %}Mon billet{% endblock %}{% block body %}<p class="eyebrow">Billet Horizon</p><h1>{{ ticket.inventairePlace.representation.evenement.titre }}</h1><article class="card"><h2>{{ ticket.inventairePlace.place.libelle }}</h2><p>{{ ticket.inventairePlace.representation.debut|casablanca_date }} · {{ ticket.inventairePlace.representation.salle.nom }}</p><p>{{ ticket.reference }} · {{ ticket.statut.label }} · {{ ticket.prixPayeCentimes|mad }}</p>{% if ticket.statut.value == 'valide' and ticket.commande.payeA %}<p><a class="btn btn-primary" href="{{ path('store_ticket_pdf', {id: ticket.id}) }}">Télécharger le billet PDF</a></p>{% else %}<p role="alert">Billet annulé ou non confirmé : téléchargement indisponible. Son historique est conservé. Une ancienne copie ne permet plus l’accès.</p>{% endif %}<a href="{{ path('store_order', {id: ticket.commande.id}) }}">Retour à la commande</a></article>{% endblock %}
