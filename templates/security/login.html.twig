{% extends 'store/base.html.twig' %}{% block title %}Connexion{% endblock %}{% block body %}<div class="page-head"><div><p class="eyebrow">Bienvenue chez Horizon</p><h1>Connexion</h1><p>Votre sélection sera retrouvée après connexion, puis revérifiée.</p></div></div><form method="post" action="{{ path('app_login') }}" class="card form-card">{% if error %}<p role="alert" class="flash flash-error">Connexion refusée. Vérifiez vos identifiants.</p>{% endif %}<label for="email">E-mail</label><input id="email" type="email" name="_username" value="{{ lastEmail }}" required autocomplete="username"><label for="password">Mot de passe</label><input id="password" type="password" name="_password" required autocomplete="current-password"><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="btn btn-primary" type="submit">Se connecter</button><p><a href="{{ path('app_register') }}">Créer un compte client</a></p></form>{% endblock %}
