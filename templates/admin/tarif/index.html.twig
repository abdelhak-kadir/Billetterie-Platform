{% extends 'admin/base.html.twig' %}

{% block title %}Tarifs{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Tarifs</h1>
            <p>Plein, réduit, groupe et invitation. Les prix sont stockés en centimes de MAD.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('admin_tarif_new') }}">Nouveau tarif</a>
    </div>

    <form class="filters" method="get" action="{{ path('admin_tarif_index') }}">
        <div class="field field-wide">
            <label for="q">Libellé</label>
            <input id="q" name="q" value="{{ q }}" placeholder="Rechercher un tarif">
        </div>
        <div class="field">
            <label for="representation">Représentation</label>
            <select id="representation" name="representation">
                <option value="">Toutes</option>
                {% for representation in representations %}
                    <option value="{{ representation.id }}" {% if representationId == representation.id %}selected{% endif %}>
                        {{ representation.evenement.titre }} — {{ representation.debut|casablanca_date }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="actif">État</label>
            <select id="actif" name="actif">
                <option value="">Tous</option>
                <option value="1" {% if actif == '1' %}selected{% endif %}>Actifs</option>
                <option value="0" {% if actif == '0' %}selected{% endif %}>Inactifs</option>
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    <div class="table-wrap" role="region" aria-label="Tableau de gestion" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th>Représentation</th>
                    <th>Libellé</th>
                    <th>Catégorie</th>
                    <th class="money">Prix</th>
                    <th>État</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for tarif in tarifs %}
                    <tr>
                        <td>
                            {{ tarif.representation.evenement.titre }}<br>
                            <small>{{ tarif.representation.debut|casablanca_date }}</small>
                        </td>
                        <td>{{ tarif.libelle }}</td>
                        <td>{{ tarif.categorie.label }}</td>
                        <td class="money">{{ tarif.prixCentimes|mad }}</td>
                        <td>
                            {% if tarif.actif %}
                                <span class="badge badge-actif">Actif</span>
                            {% else %}
                                <span class="badge badge-inactif">Inactif</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('admin_tarif_show', {id: tarif.id}) }}">Détail</a>
                                <a href="{{ path('admin_tarif_edit', {id: tarif.id}) }}">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="empty">Aucun tarif.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
