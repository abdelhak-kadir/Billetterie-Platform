{% extends 'admin/base.html.twig' %}

{% block title %}Inventaire{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Inventaire des places</h1>
            <p>Consultation seule. Filtrez par représentation, zone et disponibilité pour retrouver rapidement une place.</p>
        </div>
    </div>

    <form class="filters" method="get" action="{{ path('admin_inventaire_index') }}">
        <div class="field field-wide">
            <label for="q">Recherche</label>
            <input id="q" name="q" value="{{ q }}" placeholder="Événement, zone, rangée ou numéro (ex. A1)">
        </div>
        <div class="field">
            <label for="representation">Représentation</label>
            <select id="representation" name="representation">
                <option value="">Toutes</option>
                {% for representation in representations %}
                    <option value="{{ representation.id }}" {% if representationId == representation.id %}selected{% endif %}>
                        {{ representation.evenement.titre }} — {{ representation.debut|casablanca_date }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="zone">Zone</label>
            <select id="zone" name="zone">
                <option value="">Toutes</option>
                {% for zone in zones %}
                    <option value="{{ zone.id }}" {% if zoneId == zone.id %}selected{% endif %}>{{ zone.salle.nom }} — {{ zone.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="statut">Disponibilité</label>
            <select id="statut" name="statut">
                <option value="">Toutes</option>
                {% for choice in statuts %}
                    <option value="{{ choice.value }}" {% if statut and statut.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    {% if selectedRepresentation %}
        <section class="seat-map" aria-labelledby="seat-map-title">
            <div class="seat-map-head">
                <div>
                    <p class="eyebrow">Plan de salle</p>
                    <h2 id="seat-map-title">{{ selectedRepresentation.evenement.titre }}</h2>
                    <p class="muted">{{ selectedRepresentation.debut|casablanca_date }} · {{ selectedRepresentation.salle.nom }} · {{ mapZones|length }} zone(s){% if zoneId %} · zone filtrée{% endif %}</p>
                </div>
                <a class="btn btn-secondary" href="{{ path('admin_representation_show', {id: selectedRepresentation.id}) }}">Détail de la représentation ↗</a>
            </div>
            <div class="seat-stage" aria-hidden="true">SCÈNE</div>
            <div class="seat-legend" aria-label="Légende du plan">
                <span><i class="seat-key key-disponible" aria-hidden="true"></i>Disponible</span>
                <span><i class="seat-key key-vendue" aria-hidden="true"></i>Vendue</span>
                <span><i class="seat-key key-reservee" aria-hidden="true"></i>Réservée</span>
                <span><i class="seat-key key-bloquee" aria-hidden="true"></i>Bloquée</span>
            </div>
            {% if mapZones %}
                <div class="seat-map-scroll">
                    {% for zoneData in mapZones %}
                        <section class="seat-zone zone-{{ loop.index }}">
                            <h3>
                                <span class="zone-dot" aria-hidden="true"></span>{{ zoneData.zone.nom }}
                                <small>{{ zoneData.total }} places · {{ zoneData.counts.disponible|default(0) }} disponibles · {{ zoneData.counts.vendue|default(0) }} vendues</small>
                            </h3>
                            <svg class="seat-plan" viewBox="0 0 {{ 32 + zoneData.maxSeat * 16 }} {{ zoneData.rowCount * 18 + 18 }}" role="img" aria-label="Plan de la zone {{ zoneData.zone.nom }}">
                                {% for rangee, row in zoneData.rows %}
                                    {% set rowIndex = loop.index0 %}
                                    <text class="seat-row-label" x="8" y="{{ rowIndex * 18 + 18 }}">{{ rangee }}</text>
                                    {% for numero, inventaire in row %}
                                        <circle class="seat seat-{{ inventaire.statut.value }}" cx="{{ 24 + (numero - 1) * 16 }}" cy="{{ rowIndex * 18 + 18 }}" r="5.5">
                                            <title>{{ zoneData.zone.nom }} · rangée {{ rangee }} · place {{ numero }} · {{ inventaire.statut.label }}</title>
                                        </circle>
                                    {% endfor %}
                                {% endfor %}
                            </svg>
                        </section>
                    {% endfor %}
                </div>
                <p class="help">Plan complet de la représentation, tous statuts confondus. Survolez une place — ou consultez la liste ci-dessous — pour afficher sa référence et son état. Le tableau reste filtrable et paginé.</p>
            {% else %}
                <p class="empty">Aucune place pour cette représentation avec les filtres actuels.</p>
            {% endif %}
        </section>
    {% elseif representationId > 0 %}
        <p class="empty">Représentation introuvable. Réinitialisez les filtres pour afficher l’inventaire.</p>
    {% else %}
        <p class="inventory-prompt">Sélectionnez une représentation dans les filtres pour afficher son plan de salle. La liste paginée reste disponible ci-dessous.</p>
    {% endif %}

    <div class="inventory-summary"><span><strong>{{ pagination.total }}</strong> résultat(s) · Consultation seule</span><a href="{{ path('admin_inventaire_index') }}">Réinitialiser les filtres</a></div>
    {% if q or representationId or zoneId or statut %}
        <div class="filter-tags" aria-label="Filtres actifs">
            {% if q %}<span>Recherche : {{ q }}</span>{% endif %}
            {% for representation in representations %}{% if representation.id == representationId %}<span>{{ representation.evenement.titre }} · {{ representation.debut|casablanca_date }}</span>{% endif %}{% endfor %}
            {% for zone in zones %}{% if zone.id == zoneId %}<span>Zone : {{ zone.nom }}</span>{% endif %}{% endfor %}
            {% if statut %}<span>Statut : {{ statut.label }}</span>{% endif %}
        </div>
    {% endif %}

    <div class="table-wrap" role="region" aria-label="Tableau de gestion" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th>Événement</th>
                    <th>Date (Africa/Casablanca)</th>
                    <th>Zone</th>
                    <th>Rangée</th>
                    <th>Numéro</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for inventaire in inventaires %}
                    <tr>
                        <td>{{ inventaire.representation.evenement.titre }}</td>
                        <td>{{ inventaire.representation.debut|casablanca_date }}</td>
                        <td>{{ inventaire.place.zone.nom }}</td>
                        <td>{{ inventaire.place.rangee }}</td>
                        <td>{{ inventaire.place.numero }}</td>
                        <td><span class="badge badge-{{ inventaire.statut.value }}">{{ inventaire.statut.label }}</span></td>
                        <td><a href="{{ path('admin_representation_show', {id: inventaire.representation.id}) }}">Représentation</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty">Aucune ligne d’inventaire pour ces filtres.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
