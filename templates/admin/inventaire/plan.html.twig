{% extends 'admin/base.html.twig' %}
{% block title %}Plan de salle · {{ representation.evenement.titre }}{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="/admin/seat-map.css">{% endblock %}
{% block javascripts %}<script type="module" src="/admin/seat-map-admin.js"></script>{% endblock %}
{% block body %}
    <div class="h-admin-plan" data-admin-seat-screen data-reservation-url="{{ path('admin_sale_reserve', {id: representation.id}) }}">
        <aside class="h-event-aside" aria-label="Représentation active">
            <a class="h-aside-back" href="{{ path('admin_representation_show', {id: representation.id}) }}">← Détail de la représentation</a>
            <img class="h-aside-poster" src="{{ event_art(representation.evenement) }}" alt="" width="240" height="360">
            <div class="h-aside-content"><p class="eyebrow">{{ representation.evenement.type.label }}</p><h1>{{ representation.evenement.titre }}</h1>
                <p>{{ representation.salle.nom }}</p>
                <p class="h-active-date">{{ representation.debut|date('d/m/Y', 'Africa/Casablanca') }} <strong>{{ representation.debut|date('H:i', 'Africa/Casablanca') }}</strong><small>Africa/Casablanca</small></p>
                <span class="badge badge-{{ representation.statut.value }}">{{ representation.statut.label }}</span>
            </div>
            <button type="button" class="btn btn-secondary" data-open-dates>Dates et représentations</button>
            <nav class="h-plan-jumps" aria-label="Accès rapide au plan"><a href="#representation-plan-title">Aller au plan ↓</a>{% if selectable %}<a href="#representation-plan-selection">Sélection ↓</a>{% endif %}</nav>
            <a class="h-aside-link" href="{{ path('admin_inventaire_index', {representation: representation.id}) }}">Consulter la vue tableau ↗</a>
        </aside>
        <div class="h-working-area">
            {% if rejectedCount %}<div class="h-conflict" role="alert">{{ rejectedCount }} siège(s) ne sont plus libres ou ne correspondent pas à cette représentation. Le plan est actualisé ; revoyez les places restantes avant de continuer.</div>{% endif %}
            {% if not selectable %}<div class="h-conflict" role="status">La vente est fermée pour cette représentation. Le plan reste disponible en inspection.</div>{% endif %}
            {% include 'components/seat_map/_map.html.twig' with {instanceId: 'representation-plan', seatMap: seatMap, selectable: selectable, initialMode: initialMode, selected: selected} only %}
        </div>
        <dialog class="h-dates-dialog" data-dates-dialog aria-labelledby="h-dates-title">
            <div class="h-dialog-head"><div><p class="eyebrow">La programmation réelle</p><h2 id="h-dates-title">Dates et représentations</h2></div><button class="btn btn-secondary" type="button" data-close-dates>Fermer les dates</button></div>
            <p class="muted">{{ representation.evenement.titre }} · Africa/Casablanca</p>
            <nav class="h-date-options" aria-label="Changer de représentation">
                {% for option in representations %}<a href="{{ path('admin_representation_plan', {id: option.id}) }}" data-change-representation data-active="{{ option.id == representation.id ? 'true' : 'false' }}" {% if option.id == representation.id %}aria-current="true"{% endif %}>
                    <span>{{ option.debut|date('d/m/Y', 'Africa/Casablanca') }}</span><strong>{{ option.debut|date('H:i', 'Africa/Casablanca') }}</strong><small>{{ option.salle.nom }} · {{ option.statut.label }}</small>
                    {% if option.id == representation.id %}<span class="h-date-current">Représentation active</span>{% endif %}
                </a>{% endfor %}
            </nav>
            <div class="h-change-warning" data-change-warning hidden role="alert"><p>Changer de représentation effacera les <strong data-pending-count></strong> places sélectionnées localement. Aucune réservation n’a encore été créée.</p><div class="actions"><button class="btn btn-secondary" type="button" data-cancel-change>Garder ma sélection</button><button class="btn btn-primary" type="button" data-confirm-change>Changer et effacer</button></div></div>
        </dialog>
    </div>
{% endblock %}
