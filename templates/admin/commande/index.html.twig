{% extends 'admin/base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Commandes</h1>
            <p>Historique des commandes. Consultation uniquement : aucun changement de statut ni de prix n’est proposé.</p>
        </div>
    </div>

    <form class="filters" method="get" action="{{ path('admin_commande_index') }}">
        <div class="field field-wide">
            <label for="q">Référence ou e-mail</label>
            <input id="q" name="q" value="{{ q }}" placeholder="DEMO-CMD-R1, client@example.com…">
        </div>
        <div class="field">
            <label for="canal">Canal</label>
            <select id="canal" name="canal">
                <option value="">Tous</option>
                {% for choice in canaux %}
                    <option value="{{ choice.value }}" {% if canal and canal.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="statut">Statut</label>
            <select id="statut" name="statut">
                <option value="">Tous</option>
                {% for choice in statuts %}
                    <option value="{{ choice.value }}" {% if statut and statut.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Référence</th>
                    <th>Créée le (Africa/Casablanca)</th>
                    <th>Canal</th>
                    <th>Statut</th>
                    <th>Client</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for commande in commandes %}
                    <tr>
                        <td>{{ commande.reference }}</td>
                        <td>{{ commande.creeA|casablanca_date }}</td>
                        <td>{{ commande.canal.label }}</td>
                        <td><span class="badge badge-{{ commande.statut.value }}">{{ commande.statut.label }}</span></td>
                        <td>{{ commande.emailClient }}</td>
                        <td><a href="{{ path('admin_commande_show', {id: commande.id}) }}">Détail</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="empty">Aucune commande.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
