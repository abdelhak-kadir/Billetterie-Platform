{% extends 'admin/base.html.twig' %}
{% block title %}{{ evenement.titre }}{% endblock %}
{% block body %}
<nav class="workspace-breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('admin_index') }}">Mes événements</a><span>›</span><span>{{ evenement.titre }}</span></nav>
<section class="event-summary"><img class="hero-image" src="{{ event_art(evenement) }}" alt=""><div><p class="eyebrow">{{ evenement.type.label }} · Espace de gestion</p><h1>{{ evenement.titre }}</h1><p>{{ evenement.description ? evenement.description|slice(0,200) : 'Ajoutez les spectacles de cet événement et gérez chacun depuis sa fiche.' }}</p><div class="actions"><a class="btn btn-primary" href="{{ path('admin_event_add_shows',{id:evenement.id}) }}">+ Ajouter des spectacles et leurs prix</a><a class="btn btn-secondary" href="{{ path('admin_evenement_edit',{id:evenement.id}) }}">Modifier l’événement</a></div></div></section>
<section id="programmation"><div class="section-head"><div><p class="eyebrow">Choisissez ce que vous voulez gérer</p><h2>Les spectacles de cet événement</h2></div><a href="{{ path('admin_evenement_show',{id:evenement.id}) }}#programmation">Tous les spectacles</a></div>
<nav class="date-nav" aria-label="Dates des spectacles">{% for key,date in dates %}<a href="{{ path('admin_evenement_show',{id:evenement.id,date:key}) }}#programmation" {% if key == selectedDate %}aria-current="date"{% endif %}><span>{{ date|date('m / Y','Africa/Casablanca') }}</span><strong>{{ date|date('d','Africa/Casablanca') }}</strong><span>Voir cette date</span></a>{% endfor %}</nav>
<div class="show-card-grid">{% for representation in representations %}{% set availability = inventoryCounts[representation.id]|default({}) %}<article class="show-card"><a class="session" href="{{ path('admin_representation_show',{id:representation.id}) }}"><span class="badge badge-{{ representation.statut.value }}">{{ representation.statut.label }}</span><h3>{{ representation.nom }}</h3><strong>{{ representation.debut|date('d/m/Y · H:i','Africa/Casablanca') }}</strong><p>{{ representation.salle.nom }}</p><p>{{ availability.disponible|default(0) }} places disponibles · {{ availability.vendue|default(0) }} vendues</p><span class="session-link">Gérer ce spectacle →</span></a><footer class="show-card-footer"><a href="{{ path('admin_representation_plan',{id:representation.id}) }}">Plan des places</a><a href="{{ path('admin_representation_show',{id:representation.id}) }}#tarifs">Catégories et prix</a><a href="{{ path('admin_show_sales',{id:representation.id}) }}">Ventes</a></footer></article>{% else %}<div class="card workspace-empty"><h3>Aucune représentation pour cet événement</h3><p>Ajoutez un spectacle avec son nom, son horaire et ses prix. Les places seront créées automatiquement.</p><a class="btn btn-primary" href="{{ path('admin_event_add_shows',{id:evenement.id}) }}">Ajouter le premier spectacle</a></div>{% endfor %}</div>
</section>
{% endblock %}
