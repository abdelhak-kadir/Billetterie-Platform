{% extends 'admin/base.html.twig' %}
{% block title %}{{ evenement.titre }}{% endblock %}
{% block body %}
    <a class="back-link" href="{{ path('admin_evenement_index') }}">← Tous les événements</a>
    <section class="hero detail-hero" aria-labelledby="event-title">
        <img class="hero-image" src="{{ event_art(evenement) }}" alt="" fetchpriority="high" width="1536" height="1024">
        <div class="hero-content">
            <p class="eyebrow">{{ evenement.type.label }} <span aria-hidden="true">/</span> Horizon, salle culturelle</p>
            <h1 id="event-title">{{ evenement.titre }}</h1>
            <p class="hero-description">{{ evenement.description ? evenement.description|slice(0, 180) : 'La programmation de cet événement est à retrouver ci-dessous.' }}{{ evenement.description|length > 180 ? '…' : '' }}</p>
            <a class="btn btn-primary" href="#programmation">Voir les représentations ↗</a>
            <div class="actions"><span class="muted">Gestion de l’événement</span><a class="btn btn-secondary btn-small" href="{{ path('admin_evenement_edit', {id: evenement.id}) }}">Modifier</a></div>
        </div>
    </section>
    {% if evenement.description|length > 180 %}<details class="description-more"><summary>Lire la description complète</summary><p>{{ evenement.description }}</p></details>{% endif %}
    <section class="section" id="programmation" aria-labelledby="program-title">
        <div class="section-head"><h2 id="program-title">Les représentations</h2><span class="muted">Horaires · Africa/Casablanca</span></div>
        <nav class="date-nav" aria-label="Dates des représentations">
            {% for key, date in dates %}
                <a href="{{ path('admin_evenement_show', {id: evenement.id, date: key}) }}#programmation" {% if key == selectedDate %}aria-current="date"{% endif %} aria-label="{{ date|date('d/m/Y', 'Africa/Casablanca') }}">
                    <span>{{ date|date('m / Y', 'Africa/Casablanca') }}</span><strong>{{ date|date('d', 'Africa/Casablanca') }}</strong><span>{{ key == selectedDate ? 'Sélectionnée' : 'Voir la date' }}</span>
                </a>
            {% endfor %}
        </nav>
        <div class="sessions">
            {% for representation in representations %}
                {% set availability = inventoryCounts[representation.id]|default({}) %}
                <a class="session" href="{{ path('admin_representation_show', {id: representation.id}) }}">
                    <strong>{{ representation.debut|date('H:i', 'Africa/Casablanca') }}</strong>
                    <span class="badge badge-{{ representation.statut.value }}">{{ representation.statut.label }}</span>
                    <p>{{ representation.salle.nom }}</p><p>{{ availability.disponible|default(0) }} places disponibles · {{ availability.vendue|default(0) }} vendues</p>
                    <span class="session-link">Détail et inventaire ↗</span>
                </a>
            {% else %}<p class="empty">Aucune représentation pour cet événement.</p>{% endfor %}
        </div>
    </section>
{% endblock %}
