{% extends 'admin/base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Événements</h1>
            <p>Programme de la salle : concerts, théâtre et conférences.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('admin_evenement_new') }}">Nouvel événement</a>
    </div>

    <form class="filters" method="get" action="{{ path('admin_evenement_index') }}">
        <div class="field field-wide">
            <label for="q">Rechercher par titre</label>
            <input id="q" name="q" value="{{ q }}" placeholder="Titre de l’événement">
        </div>
        <div class="field">
            <label for="type">Type</label>
            <select id="type" name="type">
                <option value="">Tous les types</option>
                {% for choice in types %}
                    <option value="{{ choice.value }}" {% if type and type.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Titre</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for evenement in evenements %}
                    <tr>
                        <td>{{ evenement.titre }}</td>
                        <td><span class="badge badge-programmee">{{ evenement.type.label }}</span></td>
                        <td>{{ evenement.description is not empty ? evenement.description|slice(0, 120) : '—' }}</td>
                        <td>
                            <div class="actions">
                                <a href="{{ path('admin_evenement_show', {id: evenement.id}) }}">Détail</a>
                                <a href="{{ path('admin_evenement_edit', {id: evenement.id}) }}">Modifier</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="empty">Aucun événement.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
