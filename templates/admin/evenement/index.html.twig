{% extends 'admin/base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Événements</h1>
            <p>Programme de la salle : concerts, théâtre et conférences.</p>
        </div>
        <a class="btn btn-primary" href="{{ path('admin_event_setup') }}">Nouvel événement</a>
    </div>

    <form class="filters" method="get" action="{{ path('admin_evenement_index') }}">
        <div class="field field-wide">
            <label for="q">Rechercher par titre</label>
            <input id="q" name="q" value="{{ q }}" placeholder="Titre de l’événement">
        </div>
        <div class="field">
            <label for="type">Type</label>
            <select id="type" name="type">
                <option value="">Tous les types</option>
                {% for choice in types %}
                    <option value="{{ choice.value }}" {% if type and type.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    <div class="inventory-summary"><span>{{ pagination.total }} événement(s)</span><a href="{{ path('admin_evenement_index') }}">Réinitialiser les filtres</a></div>
    {% if evenements %}
        <div class="event-card-grid">
            {% for evenement in evenements %}
                {% include 'admin/workspace/_event_card.html.twig' %}
            {% endfor %}

        </div>
    {% else %}
        <p class="empty">Aucun événement pour ces filtres. Essayez une autre recherche ou réinitialisez les filtres.</p>
    {% endif %}

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
