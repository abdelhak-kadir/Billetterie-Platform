{% extends 'admin/base.html.twig' %}

{% block title %}{{ salle.nom }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('admin_salle_index') }}">← Retour aux salles</a>
    <section class="venue-banner">
        <p class="eyebrow">Le lieu / Plan physique</p>
        <span class="capacity">{{ pagination.total }}</span> <span class="muted">places numérotées</span>
        <h1>{{ salle.nom }}</h1>
        <p>{{ zones|length }} zone(s) · Un même plan pour chaque représentation.</p>
        <a class="btn btn-primary" href="{{ path('admin_representation_index', {salle: salle.id}) }}">Voir les représentations ↗</a>
    </section>
    <div class="card" style="margin-bottom: 1rem;">
        <h2 style="margin-top: 0; font-size: 1.05rem;">Zones</h2>
        <div class="actions">
            {% for zone in zones %}
                <span class="badge badge-terminee">{{ zone.nom }} · {{ zoneCounts[zone.id]|default(0) }} places</span>
            {% else %}
                <span class="muted">Aucune zone.</span>
            {% endfor %}
        </div>
    </div>

    <div class="table-wrap" role="region" aria-label="Tableau de gestion" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th>Zone</th>
                    <th>Rangée</th>
                    <th>Numéro</th>
                    <th>Libellé</th>
                </tr>
            </thead>
            <tbody>
                {% for place in places %}
                    <tr>
                        <td>{{ place.zone.nom }}</td>
                        <td>{{ place.rangee }}</td>
                        <td>{{ place.numero }}</td>
                        <td>{{ place.libelle }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="4" class="empty">Aucune place.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
