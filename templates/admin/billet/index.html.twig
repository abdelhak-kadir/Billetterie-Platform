{% extends 'admin/base.html.twig' %}

{% block title %}Billets{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Billets</h1>
            <p>Historique des billets émis. Le statut, le prix payé et les associations sont en lecture seule.</p>
        </div>
    </div>

    <form class="filters" method="get" action="{{ path('admin_billet_index') }}">
        <div class="field field-wide">
            <label for="q">Référence billet ou commande</label>
            <input id="q" name="q" value="{{ q }}" placeholder="DEMO-BIL-R1-1, DEMO-CMD-R1…">
        </div>
        <div class="field">
            <label for="representation">Représentation</label>
            <select id="representation" name="representation">
                <option value="">Toutes</option>
                {% for representation in representations %}
                    <option value="{{ representation.id }}" {% if representationId == representation.id %}selected{% endif %}>
                        {{ representation.evenement.titre }} — {{ representation.debut|casablanca_date }}
                    </option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="statut">Statut</label>
            <select id="statut" name="statut">
                <option value="">Tous</option>
                {% for choice in statuts %}
                    <option value="{{ choice.value }}" {% if statut and statut.value == choice.value %}selected{% endif %}>{{ choice.label }}</option>
                {% endfor %}
            </select>
        </div>
        <button class="btn btn-primary" type="submit">Filtrer</button>
    </form>

    <div class="table-wrap" role="region" aria-label="Tableau de gestion" tabindex="0">
        <table>
            <thead>
                <tr>
                    <th>Billet</th>
                    <th>Commande</th>
                    <th>Représentation</th>
                    <th>Place</th>
                    <th>Tarif</th>
                    <th class="money">Prix payé</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for billet in billets %}
                    <tr>
                        <td class="reference">{{ billet.reference }}</td>
                        <td><a href="{{ path('admin_commande_show', {id: billet.commande.id}) }}">{{ billet.commande.reference }}</a></td>
                        <td>
                            {{ billet.inventairePlace.representation.evenement.titre }}<br>
                            <small>{{ billet.inventairePlace.representation.debut|casablanca_date }}</small>
                        </td>
                        <td>{{ billet.inventairePlace.place.zone.nom }} / {{ billet.inventairePlace.place.rangee }} / {{ billet.inventairePlace.place.numero }}</td>
                        <td>{{ billet.tarif.libelle }}</td>
                        <td class="money">{{ billet.prixPayeCentimes|mad }}</td>
                        <td><span class="badge badge-{{ billet.statut.value }}">{{ billet.statut.label }}</span></td>
                        <td><a href="{{ path('admin_billet_show', {id: billet.id}) }}">Détail</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="empty">Aucun billet.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include 'admin/_pagination.html.twig' %}
{% endblock %}
