{% extends 'admin/base.html.twig' %}

{% block title %}Représentation #{{ representation.id }}{% endblock %}

{% block body %}
    {% set disponibles = counts.disponible|default(0) %}
    {% set vendues = counts.vendue|default(0) %}
    {% set reservees = counts.reservee|default(0) %}
    {% set bloquees = counts.bloquee|default(0) %}

    <div class="page-head">
        <div>
            <h1>{{ representation.evenement.titre }}</h1>
            <p>{{ representation.salle.nom }} · <span class="badge badge-{{ representation.statut.value }}">{{ representation.statut.label }}</span></p>
        </div>
        <div class="actions">
            <a class="btn btn-secondary" href="{{ path('admin_representation_index') }}">← Retour</a>
            <a class="btn btn-secondary" href="{{ path('admin_inventaire_index', {representation: representation.id}) }}">Voir l’inventaire</a>
            <a class="btn btn-primary" href="{{ path('admin_representation_edit', {id: representation.id}) }}">Modifier</a>
        </div>
    </div>

    <div class="grid" style="margin-bottom: 1rem;">
        <div class="card stat"><span>Date (Africa/Casablanca)</span><strong style="font-size: 1.1rem;">{{ representation.debut|casablanca_date }}</strong></div>
        <div class="card stat"><span>Disponibles</span><strong>{{ disponibles }}</strong></div>
        <div class="card stat"><span>Vendues</span><strong>{{ vendues }}</strong></div>
        <div class="card stat"><span>Réservées</span><strong>{{ reservees }}</strong></div>
        <div class="card stat"><span>Bloquées</span><strong>{{ bloquees }}</strong></div>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Tarif</th>
                    <th>Catégorie</th>
                    <th>Prix</th>
                    <th>État</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for tarif in tarifs %}
                    <tr>
                        <td>{{ tarif.libelle }}</td>
                        <td>{{ tarif.categorie.label }}</td>
                        <td>{{ tarif.prixCentimes|mad }}</td>
                        <td>
                            {% if tarif.actif %}
                                <span class="badge badge-actif">Actif</span>
                            {% else %}
                                <span class="badge badge-inactif">Inactif</span>
                            {% endif %}
                        </td>
                        <td><a href="{{ path('admin_tarif_show', {id: tarif.id}) }}">Détail</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="empty">Aucun tarif pour cette représentation.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
