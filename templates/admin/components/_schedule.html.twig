<div class="schedule-list">
    {% for representation in representations %}
        {% set availability = inventoryCounts[representation.id]|default({}) %}
        <a class="schedule-row" href="{{ path('admin_representation_plan', {id: representation.id}) }}">
            <span class="schedule-date">{{ representation.debut|date('d', 'Africa/Casablanca') }}<small>{{ representation.debut|date('m / Y', 'Africa/Casablanca') }}</small></span>
            <span class="schedule-title"><strong>{{ representation.evenement.titre }}</strong><small>{{ representation.evenement.type.label }} · {{ representation.salle.nom }}</small></span>
            <span class="schedule-time">{{ representation.debut|date('H:i', 'Africa/Casablanca') }}<small>Africa/Casablanca</small></span>
            <span class="schedule-state"><span class="badge badge-{{ representation.statut.value }}">{{ representation.statut.label }}</span><br>{{ availability.disponible|default(0) }} disponibles · {{ availability.vendue|default(0) }} vendues<br><small>{{ availability.reservee|default(0) }} réservées · {{ availability.bloquee|default(0) }} bloquées</small> <span aria-hidden="true">↗</span></span>
        </a>
    {% else %}
        <p class="empty">Aucune représentation programmée.</p>
    {% endfor %}
</div>
